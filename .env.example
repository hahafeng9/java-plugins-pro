# 复制为 .env 使用；也可以直接用环境变量。留空表示不启用。
UUID=
FILE_PATH=.tmp
SUB_PATH=sub
PORT=3000
NAME=
CFIP=
CFPORT=443
# Argo 固定隧道（两个都填才生效，都留空则用临时隧道）
ARGO_DOMAIN=
ARGO_AUTH=
ARGO_PORT=8001
DISABLE_ARGO=false
# 直连协议端口（留空不启用）
S5_PORT=
HY2_PORT=
TUIC_PORT=
ANYTLS_PORT=
REALITY_PORT=
# 哪吒监控
NEZHA_SERVER=
NEZHA_PORT=
NEZHA_KEY=
# 推送与上传
BOT_TOKEN=
CHAT_ID=
UPLOAD_URL=
PROJECT_URL=
AUTO_ACCESS=false
YT_WARPOUT=false
SHOW_LOG=true
# .so 下载源（默认 https://<arch>.00666.xyz，可自行替换）
LIB_BASE_URL=
# 插件模式伪装日志开关（false 关闭）
STEALTH_LOG=true
